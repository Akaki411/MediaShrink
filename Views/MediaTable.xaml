<UserControl x:Class="MediaShrink.Views.MediaTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Table of file groups in WizTree style: color, format, type, codec, share bar, size and count. -->
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Height="28" Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="58"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Формат" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="2" Text="Тип" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="3" Text="Кодек" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="4" Text="Процент" Style="{StaticResource Head}" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="5" Text="Размер" Style="{StaticResource Head}" TextAlignment="Right"/>
            <TextBlock Grid.Column="6" Text="Файлы" Style="{StaticResource Head}" TextAlignment="Right"/>
            <Border Grid.ColumnSpan="7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl x:Name="List" ItemsSource="{Binding Rows, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="58"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Color}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Ext}" FontWeight="SemiBold" Style="{StaticResource Cell}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{StaticResource Muted}" Style="{StaticResource Cell}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Codec}" Foreground="{StaticResource Muted}" Style="{StaticResource Cell}"/>
                                <Grid Grid.Column="4" Margin="8,6">
                                    <ProgressBar Value="{Binding Pct, Mode=OneWay}" Foreground="{Binding Tint}"/>
                                    <TextBlock Text="{Binding PctText}" Margin="6,0,0,0" FontSize="12" Style="{StaticResource Cell}"/>
                                </Grid>
                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" TextAlignment="Right" Style="{StaticResource Cell}"/>
                                <TextBlock Grid.Column="6" Text="{Binding Count, StringFormat=N0}" TextAlignment="Right" Style="{StaticResource Cell}"/>
                                <Border Grid.ColumnSpan="7" BorderBrush="{StaticResource Hair}" BorderThickness="0,0,0,1"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Hint, ElementName=Root}" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=List}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

