<Window x:Class="MediaShrink.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MediaShrink.Views"
        Title="MediaShrink" Width="1200" Height="800" MinWidth="1020" MinHeight="680"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <!-- Main window: "before" card on the left, "after" card on the right, progress and start button below. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="68"/>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Было" Style="{StaticResource Title}" Margin="0,0,0,12"/>
                    <v:FolderBox Grid.Row="1" Caption="ПАПКА С ИСХОДНИКАМИ" Path="{Binding Left.Path}"
                                 Command="{Binding PickSrc}" IsEnabled="{Binding Idle}"/>
                    <TextBlock Grid.Row="2" Text="{Binding Left.Info}" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" LineHeight="20"/>
                    <v:PieChart Grid.Row="3" Slices="{Binding Left.Slices}" Total="{Binding Left.Total}"
                                Caption="{Binding Left.Caption}"/>
                    <v:MediaTable Grid.Row="4" Rows="{Binding Left.Rows}" Hint="Выберите папку с исходниками"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="68"/>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Станет" Style="{StaticResource Title}" Margin="0,0,0,12"/>
                    <v:FolderBox Grid.Row="1" Caption="ПАПКА ДЛЯ РЕЗУЛЬТАТА" Path="{Binding Right.Path}"
                                 Command="{Binding PickDst}" IsEnabled="{Binding Idle}"/>
                    <Grid Grid.Row="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <v:TargetBox DataContext="{Binding Photo}"/>
                        <v:TargetBox Grid.Column="2" DataContext="{Binding Audio}"/>
                        <v:TargetBox Grid.Column="4" DataContext="{Binding Video}"/>
                    </Grid>
                    <v:PieChart Grid.Row="3" Slices="{Binding Right.Slices}" Total="{Binding Right.Total}"
                                Caption="{Binding Right.Caption}"/>
                    <v:MediaTable Grid.Row="4" Rows="{Binding Right.Rows}" Hint="Здесь появится прогноз размера"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <Grid>
                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Eta}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
                    </Grid>
                    <TextBlock Text="{Binding Hw}" Style="{StaticResource Label}" Margin="0,3,0,0"/>
                    <ProgressBar Style="{StaticResource Bar}" Value="{Binding Pct, Mode=OneWay}" Margin="0,8,0,0"
                                 Visibility="{Binding Running, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding BtnText}" Command="{Binding Toggle}" Width="150" Height="42">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Running}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>


